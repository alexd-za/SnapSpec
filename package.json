{
  "name": "specsnap",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Turn messy notes into beautiful living explainers.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "assets:generate": "tsx scripts/generate-assets.ts",
    "assets:compress": "tsx scripts/compress-svgz.ts",
    "assets:check": "tsx scripts/check-assets.ts",
    "video:render": "tsx scripts/render-video.ts",
    "mcp:build": "tsx scripts/build-mcps.ts",
    "ship": "pnpm lint && pnpm test && pnpm build && pnpm assets:generate && pnpm assets:compress && pnpm assets:check"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@swc/core"
    ]
  },
  "dependencies": {
    "dexie": "^4.0.10",
    "framer-motion": "^11.15.0",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@modelcontextprotocol/sdk": "^1.11.0",
    "@playwright/test": "^1.49.0",
    "@remotion/cli": "^4.0.230",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/ui": "^3.2.6",
    "esbuild": "^0.24.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "remotion": "^4.0.230",
    "svgo": "^3.3.2",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.3",
    "vitest": "^3.2.6",
    "zod": "^3.24.1"
  }
}
